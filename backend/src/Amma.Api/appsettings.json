{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Amma": ""
  },
  "Jwt": {
    "Issuer": "amma",
    "Audience": "amma-app",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "Otp": {
    "Length": 6,
    "ExpiryMinutes": 5,
    "MaxAttempts": 5,
    "ReturnCodeInResponse": false,
    "AdminDestinations": []
  },
  "Content": {
    "IncludeUnreviewed": false
  },
  "Storage": {
    "RootPath": "data/files",
    "EncryptionKey": ""
  },
  "Seed": {
    "DemoUser": false
  },
  "Reminders": {
    "Enabled": true
  },
  "RateLimits": {
    "AuthPerMinute": 20
  },
  "Cors": {
    "Origins": []
  }
}
